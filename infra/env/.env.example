APP_NAME=Stockwire Rental API
APP_ENV=development

POSTGRES_DB=stockwire_rental
POSTGRES_USER=stockwire_rental
POSTGRES_PASSWORD=stockwire_rental

VITE_API_BASE_URL=http://localhost:8000

# Prometheus / observability
PROMETHEUS_ENABLED=true
# Metrics endpoint basic auth (leave empty to disable auth on /metrics)
# PROMETHEUS_METRICS_USER=prometheus
# PROMETHEUS_METRICS_PASSWORD=metrics

# SSO / external identity
SSO_ENABLED=false
SSO_AUTO_CREATE_USERS=false
SSO_SYNC_ROLES_ON_LOGIN=true
SSO_DEFAULT_ROLE=viewer
# Map external groups to app roles (admin/manager/viewer)
SSO_GROUP_ROLE_MAP={"Stockwire-Admins":"admin","Stockwire-Managers":"manager","Stockwire-Viewers":"viewer"}

# OIDC providers map (Entra ID + Keycloak examples)
# Note: keep this as one JSON object string.
OIDC_PROVIDERS={"entra":{"enabled":true,"display_name":"Microsoft Entra ID","issuer":"https://login.microsoftonline.com/<tenant-id>/v2.0","client_id":"<entra-client-id>","client_secret":"<entra-client-secret>","authorization_endpoint":"https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize","token_endpoint":"https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token","jwks_uri":"https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys","scopes":"openid profile email","group_claim":"groups","email_claim":"preferred_username","name_claim":"name","subject_claim":"sub","allow_auto_create":false},"keycloak":{"enabled":true,"display_name":"Keycloak","issuer":"https://sso.example.com/realms/stockwire","client_id":"stockwire-web","client_secret":"<keycloak-client-secret>","authorization_endpoint":"https://sso.example.com/realms/stockwire/protocol/openid-connect/auth","token_endpoint":"https://sso.example.com/realms/stockwire/protocol/openid-connect/token","jwks_uri":"https://sso.example.com/realms/stockwire/protocol/openid-connect/certs","scopes":"openid profile email groups","group_claim":"groups","email_claim":"email","name_claim":"name","subject_claim":"sub","allow_auto_create":false}}

# SAML providers map (Entra ID + Keycloak examples)
# For Entra ID certificate, paste PEM without header/footer line breaks or use escaped newlines.
SAML_PROVIDERS={"entra_saml":{"enabled":false,"display_name":"Microsoft Entra SAML","idp_entity_id":"https://sts.windows.net/<tenant-id>/","idp_sso_url":"https://login.microsoftonline.com/<tenant-id>/saml2","idp_x509_cert":"<entra-signing-cert>","sp_entity_id":"https://stockwire.example.com/saml/metadata","acs_url":"https://stockwire.example.com/api/v1/auth/sso/saml/login","group_attribute":"http://schemas.microsoft.com/ws/2008/06/identity/claims/groups","email_attribute":"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress","name_attribute":"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name","subject_attribute":"nameid","allow_auto_create":false},"keycloak_saml":{"enabled":false,"display_name":"Keycloak SAML","idp_entity_id":"https://sso.example.com/realms/stockwire","idp_sso_url":"https://sso.example.com/realms/stockwire/protocol/saml","idp_x509_cert":"<keycloak-signing-cert>","sp_entity_id":"https://stockwire.example.com/saml/metadata","acs_url":"https://stockwire.example.com/api/v1/auth/sso/saml/login","group_attribute":"groups","email_attribute":"email","name_attribute":"name","subject_attribute":"nameid","allow_auto_create":false}}
