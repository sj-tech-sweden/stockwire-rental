{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "Patch-level updates use fix() so release-please bumps a PATCH version",
      "matchUpdateTypes": ["patch", "pin", "pinDigest", "digest", "lockFileMaintenance", "rollback", "bump"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Minor updates use feat() so release-please bumps a MINOR version",
      "matchUpdateTypes": ["minor"],
      "semanticCommitType": "feat"
    },
    {
      "description": "Major updates use feat()! (breaking) so release-please bumps a MAJOR version",
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "feat(deps)!:"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchDatasources": ["docker"],
      "groupName": "docker image updates",
      "automerge": false
    },
    {
      "matchManagers": ["pyproject"],
      "groupName": "backend dependencies",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "groupName": "frontend dependencies",
      "automerge": false
    }
  ]
}
