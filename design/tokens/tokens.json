{
  "$schema": "https://design-tokens.github.io/community-group/format/schemas/group.json",
  "name": "Stockwire Rental Design Tokens",
  "description": "Source-of-truth tokens for the Stockwire Rental interface. Compatible with Penpot via the Tokens Studio plugin or any W3C Design Tokens consumer.",
  "stockwire": {
    "color": {
      "$type": "color",
      "$description": "Brand and semantic colors",
      "brand": {
        "green": {
          "$value": "#3F873F",
          "$description": "Primary brand green (grafiskProfil)"
        },
        "green-600": {
          "$value": "#2D9148",
          "$description": "Hover/active green"
        },
        "green-dark": {
          "$value": "#35A853",
          "$description": "Accent green used in icons/accents"
        }
      },
      "profile": {
        "primary-blue": {
          "$value": "#4F80FF",
          "$description": "Reference profile primary blue token"
        }
      },
      "semantic": {
        "success": {
          "$value": "#3F873F",
          "$description": "Success states, scan OK"
        },
        "warning": {
          "$value": "#F7B84B",
          "$description": "Warnings"
        },
        "danger": {
          "$value": "#E65656",
          "$description": "Errors, destructive actions"
        },
        "info": {
          "$value": "#3F873F",
          "$description": "Info banners (maps to brand green)"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$description": "Background and surface colors",
      "900": {
        "$value": "#0C1114",
        "$description": "Deepest background"
      },
      "800": {
        "$value": "#11181D",
        "$description": "Drawer / elevated surface"
      },
      "700": {
        "$value": "#182228",
        "$description": "Cards, header, panels"
      }
    },
    "text": {
      "$type": "color",
      "$description": "Text colors",
      "primary": {
        "$value": "#E9F1EE",
        "$description": "Primary text on dark"
      },
      "secondary": {
        "$value": "#A8BAB1",
        "$description": "Secondary / muted text"
      }
    },
    "border": {
      "$type": "color",
      "$description": "Border colors",
      "subtle": {
        "$value": "#243138",
        "$description": "Subtle borders on dark surfaces"
      }
    },
    "font": {
      "$type": "fontFamily",
      "$description": "Typography families",
      "heading": {
        "$value": ["Raleway", "Arial", "sans-serif"],
        "$description": "Headings and UI emphasis (600 weight)"
      },
      "body": {
        "$value": ["Myriad Pro", "Myriad Roman", "Arial", "sans-serif"],
        "$description": "Body and dense data text (400 weight)"
      },
      "numeric": {
        "$value": ["Myriad Pro", "Myriad Roman", "Arial", "sans-serif"],
        "$description": "Numeric and scan IDs"
      }
    },
    "font-weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "font-size": {
      "$type": "dimension",
      "xs": {"$value": "0.75rem"},
      "sm": {"$value": "0.875rem"},
      "base": {"$value": "1rem"},
      "lg": {"$value": "1.1rem"},
      "xl": {"$value": "1.25rem"},
      "2xl": {"$value": "1.5rem"},
      "3xl": {"$value": "2rem"}
    },
    "spacing": {
      "$type": "dimension",
      "xs": {"$value": "4px"},
      "sm": {"$value": "8px"},
      "md": {"$value": "16px"},
      "lg": {"$value": "24px"},
      "xl": {"$value": "32px"},
      "2xl": {"$value": "48px"}
    },
    "radius": {
      "$type": "dimension",
      "sm": {"$value": "4px"},
      "md": {"$value": "8px"},
      "lg": {"$value": "12px"},
      "xl": {"$value": "16px"}
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "rgba(0, 0, 0, 0.25)",
          "type": "dropShadow",
          "x": "0px",
          "y": "1px",
          "blur": "0px",
          "spread": "0px"
        }
      },
      "elevated": {
        "$value": {
          "color": "rgba(0, 0, 0, 0.35)",
          "type": "dropShadow",
          "x": "0px",
          "y": "4px",
          "blur": "12px",
          "spread": "0px"
        }
      }
    },
    "motion": {
      "$type": "duration",
      "fast": {"$value": "150ms"},
      "base": {"$value": "250ms"},
      "slow": {"$value": "350ms"}
    }
  }
}
